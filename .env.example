# FlockLake configuration template.
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.
# Every variable the code reads must be listed here with a placeholder.

# --- Storage budget (the platform refuses work that would exceed it) ----------
FLOCKLAKE_STORAGE_BUDGET_MB=2048
FLOCKLAKE_RAW_RETENTION_DAYS=7
FLOCKLAKE_SILVER_RETENTION_DAYS=30

# --- Scope of the default demo -------------------------------------------------
# Comma-separated ODIM node names (EU) or ICAO ids (US).
FLOCKLAKE_RADARS=nldhl,nlhrw,bejab
FLOCKLAKE_SAMPLING_MINUTES=15

# --- Object storage (local S3-compatible service in docker compose) -----------
FLOCKLAKE_S3_ENDPOINT_URL=http://localhost:8333
FLOCKLAKE_S3_BUCKET=flocklake
FLOCKLAKE_S3_ACCESS_KEY_ID=change-me
FLOCKLAKE_S3_SECRET_ACCESS_KEY=change-me

# --- Lake catalog (PostgreSQL) -------------------------------------------------
FLOCKLAKE_CATALOG_DSN=postgresql://flocklake:change-me@localhost:5432/flocklake_catalog

# --- Optional upstream credentials --------------------------------------------
# Public sources (Aloft, OPERA open radar data, NEXRAD, Open-Meteo) need no key.
# Higher OPERA API rate limits: key from https://devportal.meteogate.eu/
METEOGATE_API_KEY=your-meteogate-api-key
# ERA5 reanalysis via the Copernicus Climate Data Store (optional, milestone M13).
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-api-key

# --- Observability -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
FLOCKLAKE_LOG_LEVEL=INFO
